                  {
                    "val": "Venture Debt 101: Basics and Approach",
                    "link": "https://ycombinator.com/blog/venture-debt-101-basics-and-approach"
                  },
                  {
                    "ch": [
                      {
                        "val": "by Jon Levy"
                      },
                      {
                        "kind": "time",
                        "val": "2021-08-26T00:00:00Z"
                      }
                    ]
                  },
                  {
                    "val": "In this guide, YC Managing Director Jon Levy talks about venture debt. He covers what it is, walks through some of its benefits and risks, and gives advice on how to approach the process of taking on venture debt."
                  },
                  {
                    "val": "Read More",
                    "link": "https://ycombinator.com/blog/venture-debt-101-basics-and-approach"
