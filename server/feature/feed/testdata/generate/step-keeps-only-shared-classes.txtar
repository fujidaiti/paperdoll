A class that only one node has, such as an ID, cannot select other posts.
-- page.html --
<body data-id="0"><main data-id="1">
  <article class="post only-here" data-id="2"><h2 class="title unique" href="http://example.com/a" data-id="3">A</h2></article>
  <article class="post" data-id="4"><h2 class="title" href="http://example.com/b" data-id="5">B</h2></article>
</main></body>
-- marks.json --
{"marked_posts": [{"box": 2, "title": 3, "link": 3}], "excluded_links": [], "excluded_nodes": []}
-- rules.json --
{"selectors": [{"box": [{"tag": "article", "cls": ["post"]}], "title": [{"tag": "h2", "cls": ["title"]}], "link": [{"tag": "h2", "cls": ["title"]}]}]}
