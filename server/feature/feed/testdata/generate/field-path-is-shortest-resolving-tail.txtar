A field takes the shortest end of the path from the post that resolves to its node.
-- page.html --
<body data-id="0"><main data-id="1">
  <article class="post" data-id="2"><div data-id="3"><h2 href="http://example.com/a" data-id="4">A</h2></div></article>
  <article class="post" data-id="5"><div data-id="6"><h2 href="http://example.com/b" data-id="7">B</h2></div></article>
</main></body>
-- marks.json --
{"marked_posts": [{"box": 2, "title": 4, "link": 4}], "excluded_links": [], "excluded_nodes": []}
-- rules.json --
{"selectors": [{"box": [{"tag": "article", "cls": ["post"]}], "title": [{"tag": "h2"}], "link": [{"tag": "h2"}]}]}
