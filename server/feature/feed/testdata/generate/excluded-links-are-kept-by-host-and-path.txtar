The excluded links stay exact and sorted in the rules.
-- page.html --
<body data-id="0"><main data-id="1">
  <article class="post" data-id="2"><h2 href="http://example.com/a" data-id="3">A</h2></article>
  <article class="post" data-id="4"><h2 href="http://example.com/newsletter" data-id="5">Newsletter</h2></article>
  <article class="post" data-id="6"><h2 href="http://example.com/about" data-id="7">About</h2></article>
</main></body>
-- marks.json --
{"marked_posts": [{"box": 2, "title": 3, "link": 3}], "excluded_links": ["example.com/newsletter", "example.com/about"], "excluded_nodes": []}
-- rules.json --
{
  "selectors": [{"box": [{"tag": "article", "cls": ["post"]}], "title": [{"tag": "h2"}], "link": [{"tag": "h2"}]}],
  "excludeLinks": ["example.com/about", "example.com/newsletter"]
}
