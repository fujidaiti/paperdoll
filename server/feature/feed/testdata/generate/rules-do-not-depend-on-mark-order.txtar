The rules are the same in whichever order the user marks the posts.
-- page.html --
<body data-id="0"><main data-id="1">
  <article class="post" data-id="2"><h2 href="http://example.com/a" data-id="3">A</h2></article>
  <article class="post" data-id="4"><h2 href="http://example.com/b" data-id="5">B</h2></article>
  <div class="teaser" data-id="6"><h2 href="http://example.com/c" data-id="7">C</h2></div>
  <div class="teaser" data-id="8"><h2 href="http://example.com/d" data-id="9">D</h2></div>
</main></body>
-- marks.json --
{"marked_posts": [{"box": 2, "title": 3, "link": 3}, {"box": 6, "title": 7, "link": 7}], "excluded_links": [], "excluded_nodes": []}
-- marks-reordered.json --
{"marked_posts": [{"box": 6, "title": 7, "link": 7}, {"box": 2, "title": 3, "link": 3}], "excluded_links": [], "excluded_nodes": []}
-- rules.json --
{"selectors": [
  {"box": [{"tag": "article", "cls": ["post"]}], "title": [{"tag": "h2"}], "link": [{"tag": "h2"}]},
  {"box": [{"tag": "div", "cls": ["teaser"]}], "title": [{"tag": "h2"}], "link": [{"tag": "h2"}]}
]}
