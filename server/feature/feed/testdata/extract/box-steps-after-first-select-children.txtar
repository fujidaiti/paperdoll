Each step of the box after the first selects children, so a nested article is not a post.
-- page.html --
<body data-id="0">
<section class="latest" data-id="1">
<article data-id="2">
<h2 href="http://example.com/first" data-id="3">First post</h2></article>
<div class="related" data-id="4">
<article data-id="5">
<h2 href="http://example.com/related" data-id="6">Related post</h2></article></div></section></body>
-- rules.json --
{"selectors": [{"box": [{"tag": "section", "cls": ["latest"]}, {"tag": "article"}], "title": [{"tag": "h2"}], "link": [{"tag": "h2"}]}]}
-- posts.json --
[
  {
    "title": "First post",
    "link": "http://example.com/first"
  }
]
