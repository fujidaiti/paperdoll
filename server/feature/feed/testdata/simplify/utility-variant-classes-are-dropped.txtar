Utility classes with a variant or an arbitrary value change with the design.
-- input.html --
<body><div class="max-[1199px]:flex md:grid keep"><p>Text</p></div></body>
-- want.html --
<!DOCTYPE html><html><head><title></title>
<link rel="canonical" href="http://example.com/"/></head>
<body data-id="0"><div class="keep" data-id="1"><p data-id="2">Text</p></div></body></html>
