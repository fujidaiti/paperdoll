An image that is one pixel wide or high shows no content.
-- input.html --
<body><img src="/a.png" width="1" height="300"><img src="/b.png" width="300" height="1"><p>Kept</p></body>
-- want.html --
<!DOCTYPE html><html><head><title></title>
<link rel="canonical" href="http://example.com/"/></head>
<body data-id="0"><p data-id="1">Kept</p></body></html>
