A date can be written with slashes.
-- input.html --
<body><p>1/2/2026</p><p>2026/1/2</p></body>
-- want.html --
<!DOCTYPE html><html><head><title></title>
<link rel="canonical" href="http://example.com/"/></head>
<body data-id="0"><p data-id="1"><time data-id="2">2026-01-02T00:00:00Z</time></p>
<p data-id="3"><time data-id="4">2026-01-02T00:00:00Z</time></p></body></html>
