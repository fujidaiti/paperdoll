Unsafe tags never carry post content, so they are omitted with their subtrees.
-- input.html --
<body><script>track()</script><style>p{}</style><noscript>Enable scripts</noscript>
<template><p>Template</p></template><iframe src="/ad">Fallback</iframe><object data="/x">Fallback</object>
<embed src="/e"><p>Kept</p></body>
-- want.html --
<!DOCTYPE html><html><head><title></title>
<link rel="canonical" href="http://example.com/"/></head>
<body data-id="0"><p data-id="1">Kept</p></body></html>
