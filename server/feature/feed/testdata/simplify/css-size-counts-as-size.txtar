The width and the height in an inline style count as the size of an image.
-- input.html --
<body><img src="/a.png" style="width: 40px; height: 40px"><img src="/b.png" style="width:200px;height:200px"></body>
-- want.html --
<!DOCTYPE html><html><head><title></title>
<link rel="canonical" href="http://example.com/"/></head>
<body data-id="0"><img src="http://example.com/b.png" data-id="1"/></body></html>
