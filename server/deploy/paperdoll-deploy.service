# Deploys the newest server release, if there is one. Started by
# paperdoll-deploy.timer; see paperdoll-deploy.sh.
[Unit]
Description=Deploy the newest Paperdoll server release
After=network-online.target
Wants=network-online.target
# Hook up an alert here, e.g. OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/paperdoll-deploy
StateDirectory=paperdoll-deploy
CacheDirectory=paperdoll-deploy
# gh keeps its config and the Sigstore trust root cache here instead of $HOME.
Environment=GH_CONFIG_DIR=/var/lib/paperdoll-deploy/gh
Environment=XDG_CACHE_HOME=/var/cache/paperdoll-deploy
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=GH_PROMPT_DISABLED=1
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/paperdoll
ProtectHome=yes
PrivateTmp=yes
