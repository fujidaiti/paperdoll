{
  "lsp": {
    "dart": {
      "binary": {
        "path": ".fvm/flutter_sdk/bin/dart",
        "arguments": ["language-server", "--protocol=lsp"]
      }
    },
    "gopls": {
      "initialization_options": {
        "buildFlags": ["-tags=integration"]
      }
    }
  },
  "language_servers": [
    "!tailwindcss-language-server" // Disables the Tailwind LSP
  ]
}
